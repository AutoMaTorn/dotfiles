#!/bin/sh
# menu: открыть проект
#
# Каталоги из ~/projects, самый свежий сверху, открываются в VS Code.
# Это пример: правьте под себя — каталог в DIR, чем открывать — в последней
# строке. Скрипт попадает в меню просто потому, что лежит здесь и исполняемый.

set -eu

DIR=$HOME/projects

# %T@ — время изменения, %f — имя; сортируем по времени и убираем время.
name=$(find "$DIR" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' |
       sort -rn | cut -d' ' -f2- | sponux --dmenu) || exit 0

exec code "$DIR/$name"
